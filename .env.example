SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai

# BSC mainnet RPC used for the Anvil fork (Phase 1+). Any public endpoint works;
# bsc-rpc.publicnode.com was used during Phase 0 verification.
BSC_RPC_URL=https://bsc-rpc.publicnode.com

# BSC testnet RPC for scripts/testnet-demo.ts (make deploy-testnet-demo). Optional: defaults to
# https://bsc-testnet-rpc.publicnode.com. The script refuses any chain other than 97.
TESTNET_RPC_URL=

# Only needed for source/ABI lookups against BscScan's API (used in Phase 0).
BSCSCAN_API_KEY=

# Free key from https://api.compasslabs.ai/auth/login — used only to check
# GET /v2/tokenized_assets/markets?provider=ixs&chain=bsc (read-only), resolving the open
# Phase 0 question ("is any IXS vault other than the Agentic/Permissionless one listed?") that
# gates the real "multi-vault" Phase 6 item — see spec/DECISIONS.md.
COMPASS_API_KEY=

# Finance District Prism "Project Identify Token" (Phase 6) — from the Prism Console at
# https://apps.fd.xyz/prism/. Prism is an x402-compatible payment gateway
# (developers.fd.xyz/prism/api-reference); used to check whether it can serve as a real
# facilitator/merchant backend for apps/web's x402-priced verification endpoint. Never expose
# this outside a trusted server context — Finance District's own docs warn it's a secret.
PRISM_API_KEY=

# Phase 6: the receiving address for /api/verify-paid's x402 payment gate (Base Sepolia
# testnet, chain eip155:84532 — real x402 protocol, zero real value at risk, since x402's own
# official contracts aren't deployed to BSC — see spec/DECISIONS.md, "Phase 6, sixth item").
# Unset in dev: apps/web/proxy.ts falls back to a well-known Anvil default test address
# (never a real treasury key) so the route works out of the box, clearly not a real payout
# destination.
X402_PAY_TO_ADDRESS=

# Throwaway Base Sepolia testnet-only private key for scripts/live-x402-payment-test.ts —
# closes the "payment-and-retry half not tested" gap from spec/DECISIONS.md's x402 entry.
# Generate a fresh one with `cast wallet new`, fund it via a Base Sepolia ETH faucet (gas)
# and https://faucet.circle.com (testnet USDC) — never a real-value key, never reused.
X402_TEST_WALLET_PRIVATE_KEY=

# --- Hosting (apps/web on Vercel) ---
# The demo chain RPC the fork-backed pages (/verify, /app, /honeypot, /demo,
# /api/verify-paid) read. Locally it defaults to http://127.0.0.1:8546 (scripts/fork-node.sh)
# and a ?rpc= query param overrides it. On Vercel (VERCEL=1) ?rpc= is ignored (SSRF guard,
# apps/web/lib/deployment.ts) and this is the only RPC used; unset, those pages say the demo
# chain isn't hosted. Also read by scripts/demo-driver.ts and scripts/replay-fork-demo.ts.
FORK_RPC_URL=

# Render API key, for deploying a hosted demo-chain node (planned, not yet used by any code
# in this repo). https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=
